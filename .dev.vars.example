# Copy to `.dev.vars` (git-ignored) and fill in real values.
# In production these are Worker secrets — set them with:
#   wrangler secret put APP_MASTER_KEY
#   wrangler secret put DATAFORSEO_LOGIN
#   wrangler secret put DATAFORSEO_PASSWORD

# Enables dev-only behaviour: the DataForSEO env-credential fallback below and
# the /api/v1/dev/* smoke routes. Deployed Workers get "production" from
# wrangler.jsonc `vars` — never set this to "development" on a hosted deploy,
# or tenants without their own key would spend on yours.
APP_ENV=development

# AES-256-GCM key used to encrypt per-workspace DataForSEO credentials at rest.
# Must be 32 bytes as HEX — exactly 64 hex characters (src/worker/lib/crypto.ts
# rejects anything else). Generate a fresh one: openssl rand -hex 32
APP_MASTER_KEY="replace-me-with-64-hex-characters"

# Dev fallback DataForSEO credentials, used when a workspace has none stored.
# Only ever read when APP_ENV=development (see dataforseo/credentials.ts).
# Get yours at https://dataforseo.com — OpenRefs never ships or proxies a key.
DATAFORSEO_LOGIN="you@example.com"
DATAFORSEO_PASSWORD="replace-me"

# ---------------------------------------------------------------------------
# Google Search Console (Phase 5) — OPTIONAL.
#
# Leave both unset and the module simply reports itself unconfigured:
# GET /api/v1/gsc/status answers `configured: false`, the UI shows setup
# instructions, and every other /gsc route returns 409 gsc_not_configured.
# Nothing else in OpenRefs is affected.
#
# To enable it, in the Google Cloud console:
#   1. Create (or pick) a project and enable the **Google Search Console API**.
#   2. OAuth consent screen → External. You only need the single scope
#      https://www.googleapis.com/auth/webmasters.readonly — read-only, so
#      OpenRefs can never change anything in a connected Search Console.
#      Set the privacy policy URL to your deployment's /privacy page.
#   3. Credentials → Create OAuth client ID → **Web application**, with the
#      authorized redirect URI:
#         https://<your-host>/api/v1/gsc/callback
#      For local development that is:
#         http://localhost:5173/api/v1/gsc/callback
#      It must match byte for byte — Google compares the string, and a missing
#      or extra trailing slash is a redirect_uri_mismatch.
#
# The client id is public (it appears in every auth URL) and belongs in
# wrangler.jsonc `vars` for a deployed build; it is repeated here only so local
# dev can use a different, localhost-registered client. The secret is a secret:
# in production set it with `wrangler secret put GOOGLE_CLIENT_SECRET`.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# DataForSEO egress relay — OPTIONAL, for deployments whose outbound IPs are
# throttled by DataForSEO (observed with Cloudflare Workers' shared egress).
# Point at a copy of the tiny authenticated forwarder (see docs/BACKLOG.md
# history) hosted on any box with a clean IP; leave unset to call the API
# directly (the default, and correct for local dev).
# In production set both with `wrangler secret put`.
DFS_PROXY_URL=""
DFS_PROXY_TOKEN=""
