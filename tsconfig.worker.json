{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // No DOM lib: the Worker's globals come from worker-configuration.d.ts,
    // which `npm run types` regenerates from wrangler.jsonc.
    "lib": ["ES2023"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": ["src/worker", "src/db", "src/shared", "worker-configuration.d.ts"]
}
